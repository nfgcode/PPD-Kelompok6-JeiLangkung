  steps:
  - kind: 0
    speaker: Ayu
    text: Kata nenekku, keempat lilin harus menyala dulu sebelum kita mulai.
    agitation: 0
    answer: 0
    sign: 0
  - kind: 1
    speaker: 
    text: Nyalakan keempat lilin di sudut kertas.
    agitation: 0
    answer: 0
    sign: 0
  - kind: 0
    speaker: Ayu
    text: Pegang bonekanya bertiga. Apa pun yang terjadi, jangan dilepas.
    agitation: 0
    answer: 0
    sign: 0
  - kind: 0
    speaker: Ayu
    text: Jelangkung, jelangkung, di sini ada pesta kecil-kecilan.
    agitation: 0
    answer: 0
    sign: 0
  - kind: 0
    speaker: Ayu
    text: Datang tak dijemput, pulang tak diantar.
    agitation: 0
    answer: 0
    sign: 0
  - kind: 4
    speaker: 
    text: 
    agitation: 0
    answer: 0
    sign: 0
  - kind: 2
    speaker: 
    text: Boneka tiba-tiba berat dan meronta. Jaga boneka tetap di dalam genggaman
      sampai ia tenang.
    agitation: 0.5
    answer: 0
    sign: 0
  - kind: 0
    speaker: Nisa
    text: Dia... sudah datang kah?
    agitation: 0
    answer: 0
    sign: 0
  - kind: 3
    speaker: Raka
    text: Kamu ada di sini?
    agitation: 0.3
