    sign: 0
  - kind: 4
    speaker: 
    text: 
    agitation: 0
    answer: 0
    sign: 1
  - kind: 0
    speaker: Dimas
    text: Bah, apinya miring semua. Padahal kipas mati.
    agitation: 0
    answer: 0
    sign: 0
  - kind: 0
    speaker: Dimas
    text: Tanya yang penting, Rak.
    agitation: 0
    answer: 0
    sign: 0
  - kind: 4
    speaker: 
    text: 
    agitation: 0
    answer: 0
    sign: 2
  - kind: 3
    speaker: Raka
    text: Apakah lampu akan menyala malam ini?
    agitation: 0.7
    answer: 0
    sign: 0
  - kind: 0
